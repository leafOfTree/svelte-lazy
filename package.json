{
  "name": "svelte-lazy",
  "svelte": "src/index.svelte",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "svelte": "./src/index.svelte"
    }
  },
  "version": "1.3.0",
  "types": "index.d.ts",
  "repository": "leafOfTree/svelte-lazy",
  "license": "UNLICENSE",
  "scripts": {
    "dev": "vite",
    "build:demo": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "svelte-check --tsconfig ./jsconfig.json",
    "check:svelte": "node scripts/check-svelte.js",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "record:demo": "node scripts/record-demo.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vitest/browser-playwright": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vitest-browser-svelte": "^3.1.0"
  },
  "peerDependencies": {
    "svelte": "^3.0.0 || ^4.0.0 || ^5.0.0"
  },
  "keywords": [
    "svelte",
    "lazyload",
    "lazy"
  ],
  "files": [
    "src",
    "index.d.ts",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
