{
  "name": "svelte-lazy",
  "version": "2.0.0-next.0",
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leafOfTree/svelte-lazy.git"
  },
  "license": "UNLICENSE",
  "scripts": {
    "dev": "vite",
    "build:demo": "vite build",
    "package": "svelte-package -i src -o dist && publint",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run package && svelte-check --tsconfig ./tsconfig.json",
    "check:svelte": "node scripts/check-svelte.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "record:demo": "node scripts/record-demo.mjs",
    "playground-link": "node scripts/playground-link.mjs",
    "prepack": "npm run package"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/package": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vitest/browser-playwright": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "publint": "^0.3.25",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-browser-svelte": "^3.1.0"
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "keywords": [
    "svelte",
    "lazyload",
    "lazy"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
