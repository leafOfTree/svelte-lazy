{
  "name": "svelte-lazy",
  "svelte": "src/index.svelte",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "svelte": "./src/index.svelte"
    }
  },
  "main": "index.js",
  "module": "index.mjs",
  "version": "1.4.1",
  "types": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leafOfTree/svelte-lazy.git"
  },
  "license": "UNLICENSE",
  "scripts": {
    "dev": "vite",
    "build:demo": "vite build",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "check": "npm run build && svelte-check --tsconfig ./jsconfig.json",
    "check:svelte": "node scripts/check-svelte.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "record:demo": "node scripts/record-demo.mjs",
    "playground-link": "node scripts/playground-link.mjs",
    "build": "node scripts/build.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@vitest/browser-playwright": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "rollup": "^4.64.12",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "svelte4": "npm:svelte@^4.2.20",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-browser-svelte": "^3.1.0"
  },
  "peerDependencies": {
    "svelte": "^3.0.0 || ^4.0.0 || ^5.0.0"
  },
  "keywords": [
    "svelte",
    "lazyload",
    "lazy"
  ],
  "files": [
    "src",
    "index.js",
    "index.mjs",
    "index.d.ts",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
